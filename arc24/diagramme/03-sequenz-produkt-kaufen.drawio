          <mxGeometry relative="1" as="geometry"><mxPoint x="445" y="470" as="sourcePoint" /><mxPoint x="615" y="470" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="n3" value="Order + OrderItems speichern&#xa;(Status CREATED)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="625" y="485" width="155" height="42" as="geometry" />
        </mxCell>
        <mxCell id="m6" value="6: 201 Created (orderId)" style="html=1;endArrow=open;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="615" y="550" as="sourcePoint" /><mxPoint x="445" y="550" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m7" value="7: PUT /order/{orderId}/paid" style="html=1;endArrow=block;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="445" y="590" as="sourcePoint" /><mxPoint x="615" y="590" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="n4" value="Status → PAID" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="625" y="605" width="130" height="32" as="geometry" />
        </mxCell>
        <mxCell id="m8" value="8: GET /user/{userId} (E-Mail-Adresse holen)" style="html=1;endArrow=block;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="615" y="660" as="sourcePoint" /><mxPoint x="785" y="660" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m9" value="9: Nutzerdaten" style="html=1;endArrow=open;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="785" y="700" as="sourcePoint" /><mxPoint x="615" y="700" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m10" value="10: publish order/complete (QoS 1, asynchron)" style="html=1;endArrow=block;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="615" y="740" as="sourcePoint" /><mxPoint x="955" y="740" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m11" value="11: 200 OK (Status PAID)" style="html=1;endArrow=open;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="615" y="785" as="sourcePoint" /><mxPoint x="445" y="785" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m12" value="12: 201 Created (Kaufbestätigung)" style="html=1;endArrow=open;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="445" y="825" as="sourcePoint" /><mxPoint x="275" y="825" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m13" value="13: 201 Created" style="html=1;endArrow=open;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="275" y="865" as="sourcePoint" /><mxPoint x="105" y="865" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m14" value="14: Event order/complete" style="html=1;endArrow=block;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="955" y="800" as="sourcePoint" /><mxPoint x="1125" y="800" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="n5" value="Template ORDER_CONFIRMATION&#xa;aus email-db rendern und&#xa;Versand protokollieren" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1135" y="815" width="160" height="52" as="geometry" />
        </mxCell>
        <mxCell id="m15" value="15: Bestätigungsmail (SMTP)" style="html=1;endArrow=block;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1125" y="890" as="sourcePoint" /><mxPoint x="1295" y="890" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="comp" value="Kompensierende Transaktion: Schlägt einer der Schritte 3–7 fehl, setzt der Product Service alle Artikel per markAllAsAvailable() wieder auf verfügbar und antwortet mit 503. Damit bleibt der Systemzustand konsistent, obwohl es keine service-übergreifende Datenbanktransaktion gibt." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="30" y="930" width="700" height="90" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="Legende: durchgezogen = synchroner Aufruf, gestrichelt = Antwort bzw. asynchrone MQTT-Nachricht.&#xa;Die Antwort an den Nutzer (11–13) wartet nicht auf den E-Mail-Versand (14–15) – der Kauf gilt auch dann als erfolgreich,&#xa;wenn der Email Service gerade nicht läuft." style="text;html=1;fontSize=11;align=left;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="760" y="940" width="720" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
