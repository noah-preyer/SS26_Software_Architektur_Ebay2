        <mxCell id="m1" value="1: POST /products/bulk-buy (Bearer JWT)" style="html=1;endArrow=block;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="105" y="210" as="sourcePoint" /><mxPoint x="275" y="210" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="n1" value="AuthFilter: JWT prüfen,&#xa;X-User-Id setzen" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="285" y="225" width="150" height="42" as="geometry" />
        </mxCell>
        <mxCell id="m2" value="2: Weiterleitung (Nginx verteilt auf 1 von 3 Replikaten)" style="html=1;endArrow=block;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="275" y="295" as="sourcePoint" /><mxPoint x="445" y="295" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="n2" value="markAllAsSold(): alle Artikel&#xa;in einem UPDATE reservieren.&#xa;Nicht alle frei → 409 Conflict" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="455" y="310" width="155" height="52" as="geometry" />
        </mxCell>
        <mxCell id="m3" value="3: POST /order (userId, items, currency)" style="html=1;endArrow=block;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="445" y="390" as="sourcePoint" /><mxPoint x="615" y="390" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m4" value="4: GET /products/{id} – je Artikel" style="html=1;endArrow=block;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="615" y="430" as="sourcePoint" /><mxPoint x="445" y="430" as="targetPoint" /></mxGeometry>
        </mxCell>
