        <mxCell id="comp" value="Fehlerfall: Schlägt das Speichern des Profils (Schritt 7) fehl, rollt der User Service die Erstellung des Auth-Users zurück (DELETE /delete/{id} mit X-Internal-Key, Schritt 4 rückgängig) und antwortet mit einem Fehler. E-Mail und Benutzername sind damit nicht „verwaist&quot; im Auth Service." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;" parent="1" vertex="1">
          <mxGeometry x="220" y="680" width="700" height="80" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="Legende: durchgezogen = synchroner Aufruf, gestrichelt = Antwort. &lt;br&gt;Der User Service legt die fachlichen Profildaten an, der Auth Service die Zugangsdaten (Passwort-Hash). &lt;br&gt;Der X-Internal-Key autorisiert den Backend-Aufruf zwischen User Service und Auth Service." style="text;html=1;fontSize=11;align=left;fontStyle=2;" parent="1" vertex="1">
          <mxGeometry x="665" y="790" width="540" height="50" as="geometry" />
