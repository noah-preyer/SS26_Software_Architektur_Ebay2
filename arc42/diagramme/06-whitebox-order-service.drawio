        </mxCell>
        <mxCell id="dto" value="DTOs / Domänenmodell&#xa;&#xa;OrderDto, Order, OrderItem&#xa;ProductDto, UserDto" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="470" y="400" width="270" height="110" as="geometry" />
