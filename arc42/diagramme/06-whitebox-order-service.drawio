<mxfile host="app.diagrams.net" type="device">
  <diagram id="whitebox-order" name="Whitebox Order Service">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Kapitel 5.3 – Bausteinsicht (Ebene 2): Order Service als Whitebox" style="text;html=1;fontSize=18;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="380" y="15" width="640" height="30" as="geometry" />
        </mxCell>
        <mxCell id="gw" value="API Gateway&#xa;(leitet /order/** weiter, X-User-Id)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="80" y="90" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="psin" value="Product Service&#xa;(interner Aufruf beim Checkout)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="360" y="90" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="epsin" value="POST /order,&#xa;PUT /order/{id}/paid" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="psin" target="ctrl">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="box" value="Order Service (Spring Boot, Java 21)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fillColor=none;strokeColor=#6c8ebf;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="190" width="700" height="590" as="geometry" />
        </mxCell>
        <mxCell id="ctrl" value="OrderController&#xa;@RestController&#xa;&#xa;POST /  ·  GET /{orderId}&#xa;GET /user/{userId}  ·  PUT /{orderId}/paid" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;" vertex="1" parent="1">
          <mxGeometry x="130" y="240" width="290" height="100" as="geometry" />
        </mxCell>
        <mxCell id="exh" value="GlobalExceptionHandler&#xa;+ ErrorResponse&#xa;(einheitliche Fehlerantworten)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="470" y="245" width="270" height="90" as="geometry" />
        </mxCell>
        <mxCell id="svc" value="OrderService&#xa;Geschäftslogik&#xa;&#xa;Bestellung anlegen, Preise ermitteln,&#xa;Status verwalten, Event auslösen" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
