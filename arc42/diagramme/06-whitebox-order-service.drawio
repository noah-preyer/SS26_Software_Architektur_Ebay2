        <mxCell id="e11" value="fängt Exceptions ab" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;dashed=1;strokeColor=#999999;" edge="1" parent="1" source="exh" target="ctrl">
