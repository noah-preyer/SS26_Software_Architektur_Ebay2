        <mxCell id="clients" value="Ausgehende Clients (Anti-Corruption-Schicht)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=none;strokeColor=#9673a6;dashed=1;fontSize=11;fontStyle=2;" vertex="1" parent="1">
