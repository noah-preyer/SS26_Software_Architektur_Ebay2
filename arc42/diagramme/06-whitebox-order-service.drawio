          <mxGeometry x="900" y="645" width="190" height="45" as="geometry" />
        </mxCell>
        <mxCell id="extmq" value="MQTT-Broker (Mosquitto)&#xa;→ Email Service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1">
