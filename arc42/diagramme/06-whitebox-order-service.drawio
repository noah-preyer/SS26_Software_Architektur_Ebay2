        <mxCell id="e12" value="nutzt" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;dashed=1;strokeColor=#999999;" edge="1" parent="1" source="svc" target="dto">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="Legende: Schichtung Controller → Service → Repository. Ausgehende Aufrufe sind in eigene Client-Klassen gekapselt, sodass die Geschäftslogik nichts über Protokolle (REST bzw. MQTT) wissen muss. Gestrichelte Kästen = Bausteine außerhalb des Order Service." style="text;html=1;fontSize=11;align=left;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="80" y="830" width="800" height="50" as="geometry" />
