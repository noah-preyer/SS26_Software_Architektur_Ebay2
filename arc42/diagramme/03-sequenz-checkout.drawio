        <mxCell id="n4" value="Template ORDER_CONFIRMATION&#xa;aus email-db rendern und&#xa;Versand protokollieren" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="1148" y="803" width="160" height="52" as="geometry" />
        </mxCell>
        <mxCell id="m13" value="13: Bestätigungsmail (SMTP)" style="html=1;endArrow=block;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1138" y="878" as="sourcePoint" />
            <mxPoint x="1308" y="878" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="comp" value="Kompensierende Transaktion: Schlägt die Markierung als SOLD (Schritt 5) für einen Artikel fehl, markiert der Order Service alle bereits als SOLD markierten Artikel wieder als verfügbar (PUT /products/{id}/unreserve → Status AVAILABLE) und antwortet mit 503. Damit bleibt der Systemzustand konsistent, obwohl es keine service-übergreifende Datenbanktransaktion gibt. Statusübergänge CREATED → PAID → SHIPPED → DELIVERED übernimmt danach automatisch der OrderStatusScheduler." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;" parent="1" vertex="1">
          <mxGeometry x="30" y="930" width="700" height="90" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="Legende: durchgezogen = synchroner Aufruf, gestrichelt = Antwort bzw. asynchrone MQTT-Nachricht.&#xa;Die Antwort an den Nutzer (10–11) wartet nicht auf den E-Mail-Versand (12–13) – der Kauf gilt auch dann als erfolgreich,&#xa;wenn der Email Service gerade nicht läuft." style="text;html=1;fontSize=11;align=left;fontStyle=2;" parent="1" vertex="1">
          <mxGeometry x="763" y="933" width="620" height="60" as="geometry" />
        </mxCell>
